local function isVis(tp) local cam=workspace.CurrentCamera; if not cam then return false end; local o=cam.CFrame.Position; local pr=RaycastParams.new(); pr.FilterType=Enum.RaycastFilterType.Exclude; pr.FilterDescendantsInstances={LP.Character,tp.Parent}; pr.IgnoreWater=true; local rs=workspace:Raycast(o,(tp.Position-o),pr); if not rs then return true end; if rs.Instance and rs.Instance:IsDescendantOf(tp.Parent) then return true end; return false end
