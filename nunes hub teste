FOVCircle.Thickness = 1; FOVCircle.NumSides = 60; FOVCircle.Radius = C.FOV; FOVCircle.Color = Color3.fromRGB(255,255,255); FOVCircle.Filled = false; FOVCircle.Transparency = 1; FOVCircle.Visible = false
local ESP={}
local function createESP(p) if p==LP or ESP[p] then return end; local d={box=Drawing.new("Square"),name=Drawing.new("Text"),dist=Drawing.new("Text"),healthBg=Drawing.new("Square"),healthBar=Drawing.new("Square"),skeleton={}}; d.box.Thickness=1; d.box.Color=C.ESPColor; d.box.Filled=false; d.box.Visible=false; d.name.Size=14; d.name.Center=true; d.name.Outline=true; d.name.Color=C.NameColor; d.name.Visible=false; d.dist.Size=12; d.dist.Center=true; d.dist.Outline=true; d.dist.Color=Color3.fromRGB(200,200,200); d.dist.Visible=false; d.healthBg.Thickness=1; d.healthBg.Color=Color3.fromRGB(0,0,0); d.healthBg.Filled=true; d.healthBg.Visible=false; d.healthBar.Thickness=1; d.healthBar.Color=Color3.fromRGB(0,255,0); d.healthBar.Filled=true; d.healthBar.Visible=false; for i=1,6 do local line=Drawing.new("Line"); line.Thickness=1; line.Color=C.ESPColor; line.Visible=false; d.skeleton[i]=line end; ESP[p]=d end
local function removeESP(p) local d=ESP[p]; if not d then return end; for k,o in pairs(d) do if k=="skeleton" then for _,l in pairs(o) do pcall(function() l:Remove() end) end else pcall(function() o:Remove() end) end end; ESP[p]=nil end
local function hideESP(d) pcall(function() d.box.Visible=false; d.name.Visible=false; d.dist.Visible=false; d.healthBg.Visible=false; d.healthBar.Visible=false end); for _,l in pairs(d.skeleton) do pcall(function() l.Visible=false end) end end
local function updateESP()
    local cam = workspace.CurrentCamera; if not cam then return end
    for p, d in pairs(ESP) do
        pcall(function()
            local ch = p.Character; local hrp = ch and ch:FindFirstChild("HumanoidRootPart"); local head = ch and ch:FindFirstChild("Head"); local hu = ch and ch:FindFirstChildOfClass("Humanoid")
            if not C.ESP or not (ch and hrp and head and hu and hu.Health > 0) then hideESP(d); return end
            local ds = (cam.CFrame.Position - hrp.Position).Magnitude
            if ds > C.Dist then hideESP(d); return end
            local top, onTop = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)); local bot, onBot = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
            if not onTop and not onBot then hideESP(d); return end
            local h = math.abs(top.Y - bot.Y); local w = h * 0.55; local boxX = top.X - w/2; local boxY = top.Y
            d.box.Size = Vector2.new(w, h); d.box.Position = Vector2.new(boxX, boxY); d.box.Visible = true; d.box.Color = C.ESPColor
            d.name.Text = p.Name; d.name.Position = Vector2.new(top.X, top.Y - 18); d.name.Visible = true; d.name.Color = C.NameColor
            d.dist.Text = string.format("[%d m]", math.floor(ds)); d.dist.Position = Vector2.new(top.X, top.Y + h + 2); d.dist.Visible = true
            local hpPct = hu.Health / hu.MaxHealth
            d.healthBg.Size = Vector2.new(3, h); d.healthBg.Position = Vector2.new(boxX - 6, boxY); d.healthBg.Visible = true
            d.healthBar.Size = Vector2.new(3, h * hpPct); d.healthBar.Position = Vector2.new(boxX - 6, boxY + (h * (1 - hpPct))); d.healthBar.Color = Color3.fromRGB(255 * (1 - hpPct), 255 * hpPct, 0); d.healthBar.Visible = true
            local function pr(name) local pt = ch:FindFirstChild(name); if not pt then return nil end; local v, on = cam:WorldToViewportPoint(pt.Position); if not on then return nil end; return Vector2.new(v.X, v.Y) end
            local pHead=pr("Head"); local pTorso=pr("UpperTorso") or pr("Torso"); local pLHand=pr("LeftHand") or pr("Left Arm"); local pRHand=pr("RightHand") or pr("Right Arm"); local pLFoot=pr("LeftFoot") or pr("Left Leg"); local pRFoot=pr("RightFoot") or pr("Right Leg")
            local segs={{pHead,pTorso},{pTorso,pLHand},{pTorso,pRHand},{pTorso,pLFoot},{pTorso,pRFoot},{pLHand,pRHand}}
            for i=1,6 do local a,b=segs[i][1],segs[i][2]; local line=d.skeleton[i]; if a and b then line.From=a; line.To=b; line.Visible=true; line.Color=C.ESPColor else line.Visible=false end end
        end)
    end
end
local originalSizes={}
local function applyHitbox() for _,p in pairs(P:GetPlayers()) do if p==LP then continue end; local ch=p.Character; if ch then local head=ch:FindFirstChild("Head"); if head and head:IsA("BasePart") then if not originalSizes[p] then originalSizes[p]=head.Size end; if C.Hitbox then head.Size=Vector3.new(C.HitboxSize,C.HitboxSize,C.HitboxSize) else if head.Size~=originalSizes[p] then head.Size=originalSizes[p] end end end else originalSizes[p]=nil end end end
local function doRage() if C.Rage<7 then return end; local cam=workspace.CurrentCamera; if not cam then return end; local bestT,bestD=nil,math.huge; for _,p in pairs(P:GetPlayers()) do if p==LP then continue end; local ch=p.Character; local hu=ch and ch:FindFirstChildOfClass("Humanoid"); if not (ch and hu and hu.Health>0) then continue end; local tp=ch:FindFirstChild("Head") or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso"); if not tp then continue end; local sp,on=cam:WorldToViewportPoint(tp.Position); if on and isVis(tp) then local d=(cam.CFrame.Position-tp.Position).Magnitude; if d<bestD then bestD=d; bestT=tp end end end; if bestT then local cf=cam.CFrame; cam.CFrame=CFrame.new(cf.Position,bestT.Position) end end
local function getT() local cam=workspace.CurrentCamera; if not cam then return nil end; local best,bs=nil,math.huge; local cp=cam.CFrame.Position; local sc=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y/2); for _,p in pairs(P:GetPlayers()) do if p==LP then continue end; local ch=p.Character; local hu=ch and ch:FindFirstChildOfClass("Humanoid"); if not (ch and hu and hu.Health>0) then continue end; local tp=ch:FindFirstChild("Head") or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso"); if not tp then continue end; local sp,on=cam:WorldToViewportPoint(tp.Position); if not on then continue end; local sd=(Vector2.new(sp.X,sp.Y)-sc).Magnitude; if sd>C.FOV then continue end; local d=(cp-tp.Position).Magnitude; if d>C.Dist then continue end; if C.Wall and not isVis(tp) then continue end; if sd<bs then bs=sd; best=tp end end; return best end
RS.RenderStepped:Connect(function()
    if C.ESP then updateESP() end
    applyHitbox()
    local cam=workspace.CurrentCamera; if not cam then return end
    FOVCircle.Visible=C.FOVShow; FOVCircle.Radius=C.FOV; FOVCircle.Position=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y/2)
    if C.Aim and (C.Auto or UIS:IsKeyDown(C.AimKey)) then local t=getT(); if t then local cf=cam.CFrame; cam.CFrame=cf:Lerp(CFrame.new(cf.Position,t.Position),C.Smooth) end end
    doRage()
end)
